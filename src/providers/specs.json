        },
        "limit": {
          "path": "/data/quota_5_hour/max_flows"
        },
        "remaining": {
          "path": "/data/quota_5_hour/remaining_flows"
        },
        "kind": "rolling",
        "reset": "/data/quota_5_hour/resets_at",
        "duration": 18000,
        "percent": "/data/quota_5_hour/usage_percentage"
      },
      {
        "id": "weekly",
        "unit": {
          "kind": "credits",
          "name": "zenmux-flows"
        },
        "percent_fraction": true,
        "used": {
          "path": "/data/quota_7_day/used_flows"
        },
        "limit": {
