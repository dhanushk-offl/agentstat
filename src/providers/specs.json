  "warp": {
    "url": "https://app.warp.dev/graphql/v2?op=GetRequestLimitInfo",
    "method": "POST",
    "body": {
      "query": "query GetRequestLimitInfo($requestContext: RequestContext!) { user(requestContext: $requestContext) { __typename ... on UserOutput { user { requestLimitInfo { isUnlimited nextRefreshTime requestLimit requestsUsedSinceLastRefresh } } } } }",
      "variables": {
        "requestContext": {
          "clientContext": {},
          "osContext": {
            "category": "Linux",
            "name": "Linux",
            "version": "0.0.0"
          }
        }
      },
      "operationName": "GetRequestLimitInfo"
    },
    "headers": {
      "User-Agent": "Warp/1.0",
      "x-warp-client-id": "warp-app",
      "x-warp-os-category": "Linux",
      "x-warp-os-name": "Linux",
      "x-warp-os-version": "0.0.0"
    },
    "required": [
      "/data/user/user/requestLimitInfo"
    ],
    "windows": [
      {
        "id": "requests",
        "unit": {
          "kind": "requests"
        },
        "used": {
          "path": "/data/user/user/requestLimitInfo/requestsUsedSinceLastRefresh"
        },
        "limit": {
          "path": "/data/user/user/requestLimitInfo/requestLimit"
        },
        "reset": "/data/user/user/requestLimitInfo/nextRefreshTime"
      }
    ]
  }
}
