{
  "atlascloud": {
    "url": "https://api.atlascloud.ai/public/v1/balance",
    "guards": {
      "/object": "balance",
      "/scope": "account",
      "/available/currency": "usd"
    },
    "required": [
      "/available/value"
    ],
    "balances": [
      {
        "id": "available",
        "amount": {
          "path": "/available/value"
        },
        "unit": {
          "kind": "currency",
          "name": "USD"
        }
      }
    ]
  },
  "linkup": {
