      },
      {
        "id": "organization",
        "unit": {
          "kind": "credits",
          "name": "gitkraken"
        },
        "unlimited_value": "-1",
        "used": {
          "path": "/data/organization/used"
        },
        "limit": {
          "path": "/data/organization/limit"
        },
        "kind": "rolling",
        "reset": "/data/resetsOn",
        "duration": 604800
      }
    ]
  },
