  "gitkraken": {
    "url": "https://api.gitkraken.dev/v1/ai-tasks/usage",
    "headers": {
      "Client-Name": "agentstat",
      "Client-Version": "0.1.0"
    },
    "required": [
      "/data/used",
      "/data/limit"
    ],
    "windows": [
      {
        "id": "personal",
        "unit": {
          "kind": "credits",
          "name": "gitkraken"
        },
        "unlimited_value": "-1",
        "used": {
          "path": "/data/used"
        },
        "limit": {
          "path": "/data/limit"
        },
        "kind": "rolling",
        "reset": "/data/resetsOn",
