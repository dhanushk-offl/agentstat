  "zenmux": {
    "url": "https://zenmux.ai/api/v1/management/subscription/detail",
    "guards": {
      "/success": true
    },
    "required": [
      "/data/quota_5_hour",
      "/data/quota_7_day"
    ],
    "plan": "/data/plan/tier",
    "windows": [
      {
        "id": "five-hour",
        "unit": {
          "kind": "credits",
          "name": "zenmux-flows"
        },
